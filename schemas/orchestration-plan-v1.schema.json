{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fusiontechstrategies/Windows-Admin-Toolkit/schemas/orchestration-plan-v1.schema.json",
  "title": "Windows Admin Toolkit controlled orchestration plan",
  "description": "Version 1.0 reviewable execution plan for Windows Admin Toolkit 3.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolkitVersion", "planId", "createdAtUtc", "request", "approval", "planHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "toolkitVersion": { "const": "3.0.0" },
    "planId": { "type": "string", "format": "uuid" },
    "createdAtUtc": { "$ref": "#/$defs/utcTimestamp" },
    "request": { "$ref": "#/$defs/request" },
    "approval": { "$ref": "#/$defs/approval" },
    "planHash": { "$ref": "#/$defs/planHash" }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "actionName", "readOnly", "targetMode", "targets", "transport", "inputs", "policy", "safety"],
      "properties": {
        "actionId": { "$ref": "#/$defs/stableActionId" },
        "actionName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "readOnly": { "type": "boolean" },
        "targetMode": { "type": "string", "enum": ["Local", "Remote"] },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/target" }
        },
        "transport": { "$ref": "#/$defs/transport" },
        "inputs": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/input" }
        },
        "policy": { "$ref": "#/$defs/policy" },
        "safety": { "$ref": "#/$defs/safety" }
      },
      "allOf": [
        {
          "if": { "properties": { "readOnly": { "const": true } }, "required": ["readOnly"] },
          "then": { "properties": { "safety": { "properties": { "requiredConfirmationText": { "type": "null" } } } } }
        },
        {
          "if": { "properties": { "readOnly": { "const": false } }, "required": ["readOnly"] },
          "then": { "properties": { "safety": { "properties": { "requiredConfirmationText": { "type": "string", "minLength": 1 }, "retryCount": { "const": 0 } } } } }
        },
        {
          "if": { "properties": { "targetMode": { "const": "Local" } }, "required": ["targetMode"] },
          "then": { "properties": { "targets": { "maxItems": 1 }, "transport": { "properties": { "name": { "const": "Local" } } } } }
        },
        {
          "if": { "properties": { "targetMode": { "const": "Remote" } }, "required": ["targetMode"] },
          "then": { "properties": { "transport": { "properties": { "name": { "enum": ["WinRM", "PsExec"] } } } } }
        }
      ]
    },
    "stableActionId": {
      "type": "string",
      "enum": [
        "SystemInfo", "DiskSpace", "HardwareInfo", "NetworkConfig", "LoggedOnUsers",
        "RunningProcesses", "SoftwareInventory", "LicenseStatus", "WindowsUpdate",
        "ScheduleReboot", "PendingReboot", "ServiceManagement", "TerminateProcess",
        "ClearTempFiles", "ScheduledTasks", "FirewallStatus", "EventLogQuery", "RegistryRead"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "targetId", "name"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 499 },
        "targetId": { "type": "string", "pattern": "^t-[0-9a-f]{24}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 253 }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "authentication", "useSsl", "psExecPath", "psExecSha256"],
      "properties": {
        "name": { "type": "string", "enum": ["Local", "WinRM", "PsExec"] },
        "authentication": { "type": ["string", "null"], "enum": ["Default", "Kerberos", "Negotiate", null] },
        "useSsl": { "type": "boolean" },
        "psExecPath": { "type": ["string", "null"], "maxLength": 32767 },
        "psExecSha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "name": { "const": "Local" } }, "required": ["name"] },
          "then": { "properties": { "authentication": { "type": "null" }, "useSsl": { "const": false }, "psExecPath": { "type": "null" }, "psExecSha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "name": { "const": "WinRM" } }, "required": ["name"] },
          "then": { "properties": { "authentication": { "type": "string", "enum": ["Default", "Kerberos", "Negotiate"] }, "psExecPath": { "type": "null" }, "psExecSha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "name": { "const": "PsExec" } }, "required": ["name"] },
          "then": { "properties": { "authentication": { "type": "null" }, "useSsl": { "const": false }, "psExecPath": { "type": "string", "minLength": 1 }, "psExecSha256": { "$ref": "#/$defs/sha256" } } }
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$" },
        "value": {
          "anyOf": [
            { "type": "string", "maxLength": 32767 },
            { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
            { "type": "boolean" },
            { "type": "null" },
            {
              "type": "array",
              "maxItems": 100,
              "items": {
                "anyOf": [
                  { "type": "string", "maxLength": 32767 },
                  { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
                  { "type": "boolean" },
                  { "type": "null" }
                ]
              }
            }
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "path", "fileSha256", "schemaVersion", "profileName", "decision", "reasonCode"],
      "properties": {
        "applied": { "type": "boolean" },
        "path": { "type": ["string", "null"], "maxLength": 32767 },
        "fileSha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "schemaVersion": { "type": ["string", "null"], "enum": ["1.0", null] },
        "profileName": { "type": ["string", "null"], "maxLength": 64 },
        "decision": { "type": "string", "enum": ["NotApplied", "Allowed"] },
        "reasonCode": { "type": "string", "enum": ["NoPolicy", "PolicyAllowed"] }
      },
      "allOf": [
        {
          "if": { "properties": { "applied": { "const": false } }, "required": ["applied"] },
          "then": { "properties": { "path": { "type": "null" }, "fileSha256": { "type": "null" }, "schemaVersion": { "type": "null" }, "profileName": { "type": "null" }, "decision": { "const": "NotApplied" }, "reasonCode": { "const": "NoPolicy" } } }
        },
        {
          "if": { "properties": { "applied": { "const": true } }, "required": ["applied"] },
          "then": { "properties": { "path": { "type": "string", "minLength": 1 }, "fileSha256": { "$ref": "#/$defs/sha256" }, "schemaVersion": { "const": "1.0" }, "profileName": { "type": "string", "minLength": 1 }, "decision": { "const": "Allowed" }, "reasonCode": { "const": "PolicyAllowed" } } }
        }
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "whatIf", "maxConcurrentJobs", "retryCount", "retryDelaySeconds", "operationTimeoutMinutes", "connectivityTimeoutSeconds", "skipConnectivityCheck", "requiredConfirmationText", "targetListConfirmationRequired", "psExecConfirmationRequired", "identityMode"],
      "properties": {
        "preflight": { "type": "boolean" },
        "whatIf": { "type": "boolean" },
        "maxConcurrentJobs": { "type": "integer", "minimum": 1, "maximum": 32 },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "retryDelaySeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "operationTimeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 180 },
        "connectivityTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "skipConnectivityCheck": { "type": "boolean" },
        "requiredConfirmationText": { "type": ["string", "null"], "maxLength": 64 },
        "targetListConfirmationRequired": { "type": "boolean" },
        "psExecConfirmationRequired": { "type": "boolean" },
        "identityMode": { "const": "CurrentWindowsIdentity" }
      },
      "not": { "properties": { "preflight": { "const": true }, "whatIf": { "const": true } }, "required": ["preflight", "whatIf"] }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approvedBy", "approvedAtUtc", "reference", "planHash", "approvalHash"],
      "properties": {
        "status": { "type": "string", "enum": ["Pending", "Approved"] },
        "approvedBy": { "type": ["string", "null"], "maxLength": 128 },
        "approvedAtUtc": {
          "anyOf": [
            { "$ref": "#/$defs/utcTimestamp" },
            { "type": "null" }
          ]
        },
        "reference": { "type": ["string", "null"], "maxLength": 256 },
        "planHash": { "$ref": "#/$defs/sha256" },
        "approvalHash": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "Pending" } }, "required": ["status"] },
          "then": { "properties": { "approvedBy": { "type": "null" }, "approvedAtUtc": { "type": "null" }, "reference": { "type": "null" }, "approvalHash": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "Approved" } }, "required": ["status"] },
          "then": { "properties": { "approvedBy": { "type": "string", "minLength": 1 }, "approvedAtUtc": { "$ref": "#/$defs/utcTimestamp" }, "reference": { "type": "string", "minLength": 1 }, "approvalHash": { "$ref": "#/$defs/sha256" } } }
        }
      ]
    },
    "planHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "value"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "canonicalization": { "const": "WAT-PLAN-1" },
        "value": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
