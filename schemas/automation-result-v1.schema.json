{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fusiontechstrategies/Windows-Admin-Toolkit/schemas/automation-result-v1.schema.json",
  "title": "Windows Admin Toolkit automation result",
  "description": "Version 1.2 machine-readable result envelope for Windows Admin Toolkit 3.0.0 automation runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolkitVersion",
    "runId",
    "startedAtUtc",
    "finishedAtUtc",
    "durationMs",
    "actionId",
    "actionName",
    "readOnly",
    "stateChanging",
    "preflight",
    "targetMode",
    "transport",
    "policy",
    "audit",
    "status",
    "outcome",
    "exitCode",
    "targetCount",
    "recordCount",
    "targets",
    "warnings",
    "errors",
    "reportPaths",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2"
    },
    "toolkitVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "startedAtUtc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "finishedAtUtc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "actionId": {
      "anyOf": [
        { "$ref": "#/$defs/stableActionId" },
        { "type": "null" }
      ]
    },
    "actionName": {
      "type": ["string", "null"]
    },
    "readOnly": {
      "type": ["boolean", "null"]
    },
    "stateChanging": {
      "type": ["boolean", "null"]
    },
    "preflight": {
      "type": "boolean"
    },
    "targetMode": {
      "type": ["string", "null"],
      "enum": ["Local", "Remote", null]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "authentication", "useSsl"],
      "properties": {
        "name": {
          "type": ["string", "null"],
          "enum": ["Local", "WinRM", "PsExec", null]
        },
        "authentication": {
          "type": ["string", "null"],
          "enum": ["Default", "Kerberos", "Negotiate", null]
        },
        "useSsl": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "$ref": "#/$defs/policyDecision"
    },
    "audit": {
      "$ref": "#/$defs/auditMetadata"
    },
    "status": {
      "type": "string",
      "enum": [
        "Succeeded",
        "PartiallySucceeded",
        "ValidationFailed",
        "AuthorizationFailed",
        "Failed",
        "TimedOut",
        "InternalFailure",
        "WhatIf"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "CompleteSuccess",
        "PartialSuccess",
        "ValidationFailure",
        "AuthorizationFailure",
        "ExecutionFailure",
        "Timeout",
        "InternalFailure"
      ]
    },
    "exitCode": {
      "type": "integer",
      "enum": [0, 1, 2, 3, 4, 5, 10]
    },
    "targetCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/targetResult"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "reportPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionDescriptor"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "CompleteSuccess" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 0 }, "status": { "enum": ["Succeeded", "WhatIf"] } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "PartialSuccess" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 1 }, "status": { "const": "PartiallySucceeded" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "ValidationFailure" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 2 }, "status": { "const": "ValidationFailed" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "AuthorizationFailure" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 3 }, "status": { "const": "AuthorizationFailed" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "ExecutionFailure" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 4 }, "status": { "const": "Failed" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "Timeout" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 5 }, "status": { "const": "TimedOut" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "InternalFailure" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 10 }, "status": { "const": "InternalFailure" } } }
    }
  ],
  "$defs": {
    "stableActionId": {
      "type": "string",
      "enum": [
        "SystemInfo",
        "DiskSpace",
        "HardwareInfo",
        "NetworkConfig",
        "LoggedOnUsers",
        "RunningProcesses",
        "SoftwareInventory",
        "LicenseStatus",
        "WindowsUpdate",
        "ScheduleReboot",
        "PendingReboot",
        "ServiceManagement",
        "TerminateProcess",
        "ClearTempFiles",
        "ScheduledTasks",
        "FirewallStatus",
        "EventLogQuery",
        "RegistryRead",
        "CustomCommand",
        "CustomPowerShell"
      ]
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "targetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "target",
        "status",
        "startedAtUtc",
        "finishedAtUtc",
        "durationMs",
        "attempts",
        "errorCategory",
        "errorMessage",
        "data"
      ],
      "properties": {
        "targetId": {
          "type": "string",
          "pattern": "^t-[0-9a-f]{24}$"
        },
        "target": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["Success", "Partial", "Failed", "TimedOut", "WhatIf", "Skipped"]
        },
        "startedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "finishedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "errorCategory": {
          "type": ["string", "null"],
          "enum": [
            "Validation",
            "Authorization",
            "Authentication",
            "Connectivity",
            "Timeout",
            "OutputLimit",
            "Execution",
            "Internal",
            null
          ]
        },
        "errorMessage": {
          "type": ["string", "null"]
        },
        "data": {
          "type": "array",
          "items": {}
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message"],
      "properties": {
        "category": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "policyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "schemaVersion", "profileName", "decision", "reasonCode", "reason"],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "schemaVersion": {
          "type": ["string", "null"],
          "enum": ["1.0", null]
        },
        "profileName": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "decision": {
          "type": "string",
          "enum": ["NotApplied", "NotEvaluated", "Allowed", "Denied", "Invalid"]
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1036
        }
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "NotApplied"}}, "required": ["decision"]},
          "then": {
            "properties": {
              "applied": {"const": false},
              "schemaVersion": {"type": "null"},
              "profileName": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"decision": {"enum": ["Allowed", "Denied"]}}, "required": ["decision"]},
          "then": {
            "properties": {
              "applied": {"const": true},
              "schemaVersion": {"const": "1.0"},
              "profileName": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"decision": {"const": "Invalid"}}, "required": ["decision"]},
          "then": {"properties": {"applied": {"const": true}}}
        }
      ]
    },
    "auditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "schemaVersion",
        "path",
        "eventLog",
        "eventSource",
        "recordCount",
        "complete",
        "hashAlgorithm",
        "canonicalization",
        "summaryHash"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "schemaVersion": { "type": ["string", "null"], "enum": ["1.0", null] },
        "path": { "type": ["string", "null"] },
        "eventLog": { "type": "boolean" },
        "eventSource": { "type": ["string", "null"], "maxLength": 128 },
        "recordCount": { "type": "integer", "minimum": 0, "maximum": 1006 },
        "complete": { "type": "boolean" },
        "hashAlgorithm": { "type": ["string", "null"], "enum": ["SHA-256", null] },
        "canonicalization": { "type": ["string", "null"], "enum": ["WAT-AUDIT-SUMMARY-1", null] },
        "summaryHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "schemaVersion": { "type": "null" },
              "path": { "type": "null" },
              "eventLog": { "const": false },
              "eventSource": { "type": "null" },
              "recordCount": { "const": 0 },
              "complete": { "const": false },
              "hashAlgorithm": { "type": "null" },
              "canonicalization": { "type": "null" },
              "summaryHash": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "complete": { "const": true } }, "required": ["complete"] },
          "then": {
            "properties": {
              "enabled": { "const": true },
              "schemaVersion": { "const": "1.0" },
              "recordCount": { "minimum": 4 },
              "hashAlgorithm": { "const": "SHA-256" },
              "canonicalization": { "const": "WAT-AUDIT-SUMMARY-1" },
              "summaryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        {
          "if": { "properties": { "eventLog": { "const": true } }, "required": ["eventLog"] },
          "then": { "properties": { "eventSource": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "actionDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "classification", "confirmationText", "inputs", "policyDecision", "policyReasonCode"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableActionId"
        },
        "displayName": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "enum": ["ReadOnly", "StateChanging", "Conditional"]
        },
        "confirmationText": {
          "type": ["string", "null"]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputDescriptor"
          }
        },
        "policyDecision": {
          "type": "string",
          "enum": ["NotApplied", "Allowed", "Denied"]
        },
        "policyReasonCode": {
          "type": "string",
          "enum": ["NoPolicy", "PolicyAllowed", "ActionDenied", "ActionNotAllowed"]
        }
      }
    },
    "inputDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "default",
        "allowedValues",
        "minimum",
        "maximum",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "allowedValues": {
          "type": "array",
          "items": {}
        },
        "minimum": {
          "type": ["integer", "null"]
        },
        "maximum": {
          "type": ["integer", "null"]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
