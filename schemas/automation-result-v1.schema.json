{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fusiontechstrategies/Windows-Admin-Toolkit/schemas/automation-result-v1.schema.json",
  "title": "Windows Admin Toolkit automation result",
  "description": "Version 1.0 machine-readable result envelope for Windows Admin Toolkit 2.1.0 automation runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolkitVersion",
    "runId",
    "startedAtUtc",
    "finishedAtUtc",
    "durationMs",
    "actionId",
    "actionName",
    "readOnly",
    "stateChanging",
    "targetMode",
    "transport",
    "status",
    "outcome",
    "exitCode",
    "targetCount",
    "recordCount",
    "targets",
    "warnings",
    "errors",
    "reportPaths",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "toolkitVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "startedAtUtc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "finishedAtUtc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "actionId": {
      "anyOf": [
        { "$ref": "#/$defs/stableActionId" },
        { "type": "null" }
      ]
    },
    "actionName": {
      "type": ["string", "null"]
    },
    "readOnly": {
      "type": ["boolean", "null"]
    },
    "stateChanging": {
      "type": ["boolean", "null"]
    },
    "targetMode": {
      "type": ["string", "null"],
      "enum": ["Local", "Remote", null]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "authentication", "useSsl"],
      "properties": {
        "name": {
          "type": ["string", "null"],
          "enum": ["Local", "WinRM", "PsExec", null]
        },
        "authentication": {
          "type": ["string", "null"],
          "enum": ["Default", "Kerberos", "Negotiate", null]
        },
        "useSsl": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Succeeded",
        "PartiallySucceeded",
        "ValidationFailed",
        "AuthorizationFailed",
        "Failed",
        "TimedOut",
        "InternalFailure",
        "WhatIf"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "CompleteSuccess",
        "PartialSuccess",
        "ValidationFailure",
        "AuthorizationFailure",
        "ExecutionFailure",
        "Timeout",
        "InternalFailure"
      ]
    },
    "exitCode": {
      "type": "integer",
      "enum": [0, 1, 2, 3, 4, 5, 10]
    },
    "targetCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/targetResult"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "reportPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionDescriptor"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "CompleteSuccess" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 0 }, "status": { "enum": ["Succeeded", "WhatIf"] } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "PartialSuccess" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 1 }, "status": { "const": "PartiallySucceeded" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "ValidationFailure" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 2 }, "status": { "const": "ValidationFailed" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "AuthorizationFailure" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 3 }, "status": { "const": "AuthorizationFailed" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "ExecutionFailure" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 4 }, "status": { "const": "Failed" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "Timeout" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 5 }, "status": { "const": "TimedOut" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "InternalFailure" } }, "required": ["outcome"] },
      "then": { "properties": { "exitCode": { "const": 10 }, "status": { "const": "InternalFailure" } } }
    }
  ],
  "$defs": {
    "stableActionId": {
      "type": "string",
      "enum": [
        "SystemInfo",
        "DiskSpace",
        "HardwareInfo",
        "NetworkConfig",
        "LoggedOnUsers",
        "RunningProcesses",
        "SoftwareInventory",
        "LicenseStatus",
        "WindowsUpdate",
        "ScheduleReboot",
        "PendingReboot",
        "ServiceManagement",
        "TerminateProcess",
        "ClearTempFiles",
        "ScheduledTasks",
        "FirewallStatus",
        "EventLogQuery",
        "RegistryRead",
        "CustomCommand",
        "CustomPowerShell"
      ]
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "targetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "status",
        "startedAtUtc",
        "finishedAtUtc",
        "durationMs",
        "attempts",
        "errorCategory",
        "errorMessage",
        "data"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["Success", "Partial", "Failed", "TimedOut", "WhatIf", "Skipped"]
        },
        "startedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "finishedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "errorCategory": {
          "type": ["string", "null"],
          "enum": [
            "Validation",
            "Authorization",
            "Authentication",
            "Connectivity",
            "Timeout",
            "OutputLimit",
            "Execution",
            "Internal",
            null
          ]
        },
        "errorMessage": {
          "type": ["string", "null"]
        },
        "data": {
          "type": "array",
          "items": {}
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message"],
      "properties": {
        "category": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "actionDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "classification", "confirmationText", "inputs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableActionId"
        },
        "displayName": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "enum": ["ReadOnly", "StateChanging", "Conditional"]
        },
        "confirmationText": {
          "type": ["string", "null"]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputDescriptor"
          }
        }
      }
    },
    "inputDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "default",
        "allowedValues",
        "minimum",
        "maximum",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "allowedValues": {
          "type": "array",
          "items": {}
        },
        "minimum": {
          "type": ["integer", "null"]
        },
        "maximum": {
          "type": ["integer", "null"]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
